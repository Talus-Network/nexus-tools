# memory-memwal Tools — environment configuration template
#
# Copy this file to `.env` (do not commit) and fill in real values, or export
# the variables in your deployment environment. The Tools binary reads these
# at startup (in `NexusTool::new()`) and at bind time (`BIND_ADDR`).

# =============================================================================
# Required
# =============================================================================

# Hex-encoded 32-byte Ed25519 delegate private key (64 hex chars, no 0x prefix).
#
# Identifies this Tools deployment to the MemWal relayer. Every signed request
# uses this key; possession of it = ability to read/write the associated
# MemWal account's memories.
#
# Provisioning: create a MemWal account via the SDK / Playground app, then
# register a delegate key against it. See https://docs.memwal.ai
#
# Validation at startup:
#   - Unset / empty: the binary boots (so `/tools` listing still works) and
#     writes a one-shot WARN to stderr. Every signed call (`/invoke`) and
#     per-tool `/health` will then fail with `AuthError::MissingKey`.
#   - Set but not valid hex, or hex that does not decode to exactly 32
#     bytes (the Ed25519 scalar shape used by MemWal — the same scheme
#     Sui's default account key uses): the binary writes a FATAL message
#     to stderr and exits with code 1. An explicitly-set-but-broken key is
#     always a misconfiguration, so the process refuses to start rather
#     than masking the problem behind a green-looking /tools endpoint.
#   - Set and valid: used as-is. The relayer additionally verifies the
#     derived public key is registered on-chain as a delegate for a MemWal
#     account; that authority check is server-side and surfaces as HTTP
#     401/403 at request time if it fails.
MEMWAL_DELEGATE_PRIVATE_KEY=

# =============================================================================
# Optional
# =============================================================================

# MemWal account object ID (the on-chain Sui Move object that owns the
# delegate keys). Format: a 0x-prefixed 64-hex-char Sui object ID, e.g.
#   0x1234abcd...ef
#
# When set, the tools send `x-account-id` on every signed request AND
# include the value in the canonical signed message — matching the JS SDK
# 1:1 and letting the relayer skip its slow registry scan.
#
# When unset, the relayer falls back to scanning the on-chain registry by
# public key. That path is slower and can return HTTP 401 if the key has
# not yet propagated, so explicitly setting MEMWAL_ACCOUNT_ID is the
# recommended configuration for testnet / mainnet deployments.
#
# You receive this ID when you create a MemWal account via the SDK or
# Playground app.
MEMWAL_ACCOUNT_ID=

# MemWal relayer base URL.
#
# Known public endpoints:
#   mainnet  https://relayer.memwal.ai
#   testnet  https://relayer.staging.memwal.ai    (default when unset)
#
# The default points at testnet so the beta API can be exercised without
# spending real SUI; set this explicitly to switch to mainnet or a
# self-hosted relayer. The URL is validated at startup: only `https://`
# is accepted unless `MEMWAL_ALLOW_INSECURE=1` is also set (local-dev only).
MEMWAL_SERVER_URL=

# Accept `http://` relayer URLs. Local development and mockito tests only —
# production deploys must leave this unset.
# MEMWAL_ALLOW_INSECURE=1

# Bind address for the bundled HTTP server (provided by nexus-toolkit).
#
# Format: `host:port`. Default: `127.0.0.1:8080`.
# Use `0.0.0.0:8080` to accept connections from outside the local host.
BIND_ADDR=
