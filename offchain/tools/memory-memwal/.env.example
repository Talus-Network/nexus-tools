# memory-memwal — environment template. Copy to `.env` (gitignored) or
# export in the deployment environment.

# Required. Hex-encoded 32-byte Ed25519 delegate private key (64 hex chars).
# Unset → boot continues, every signed call fails. Malformed → FATAL exit.
MEMWAL_DELEGATE_PRIVATE_KEY=

# Recommended. MemWal account object ID (`0x…`, 64 hex chars). Sent as
# `x-account-id` and signed into the canonical message. Unset → relayer
# falls back to an on-chain registry scan by public key (slower, flakier).
MEMWAL_ACCOUNT_ID=

# Optional. Default `https://relayer.staging.memwal.ai` (testnet).
# Use `https://relayer.memwal.ai` for mainnet. Validated at startup;
# only `https://` accepted unless MEMWAL_ALLOW_INSECURE=1.
MEMWAL_SERVER_URL=

# Dev/test only. Accept `http://` URLs (e.g. mockito). Leave unset in prod.
# MEMWAL_ALLOW_INSECURE=1

# Optional. Bind address for the bundled HTTP server. Default `127.0.0.1:8080`.
# Use `0.0.0.0:8080` to accept external connections.
BIND_ADDR=
